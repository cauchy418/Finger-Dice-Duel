using FingerDiceDuel.Core;
using FingerDiceDuel.Assistant;
var boot=UnityEngine.Object.FindObjectOfType<FingerDiceDuel.UI.GameBootstrap>();
var flags=System.Reflection.BindingFlags.NonPublic|System.Reflection.BindingFlags.Public|System.Reflection.BindingFlags.Instance;
System.Func<object,string,object> field=(o,n)=>o.GetType().GetField(n,flags).GetValue(o);
System.Action<string,object[]> invoke=(n,a)=>boot.GetType().GetMethod(n,flags).Invoke(boot,a);
var board=(FingerDiceDuel.UI.GameBoardUI)field(boot,"_board");var canvas=((UnityEngine.RectTransform)field(board,"_canvasRoot")).GetComponent<UnityEngine.Canvas>();
var folder=System.IO.Path.GetFullPath("Art/Integration/skill-animation-finals");System.IO.Directory.CreateDirectory(folder);
var checks=new System.Collections.Generic.List<string>();
System.Action<bool,string> check=(ok,s)=>{if(!ok)throw new System.Exception(s);checks.Add("PASS "+s);};
System.Action<string> shot=name=>{
 var go=new UnityEngine.GameObject("AnimationReviewCamera",typeof(UnityEngine.Camera));var cam=go.GetComponent<UnityEngine.Camera>();cam.enabled=false;cam.orthographic=true;cam.clearFlags=UnityEngine.CameraClearFlags.SolidColor;
 var rt=new UnityEngine.RenderTexture(1280,720,24);var tex=new UnityEngine.Texture2D(1280,720,UnityEngine.TextureFormat.RGB24,false);var old=UnityEngine.RenderTexture.active;var mode=canvas.renderMode;var oldCam=canvas.worldCamera;float dist=canvas.planeDistance;
 try{cam.targetTexture=rt;canvas.renderMode=UnityEngine.RenderMode.ScreenSpaceCamera;canvas.worldCamera=cam;canvas.planeDistance=10;UnityEngine.Canvas.ForceUpdateCanvases();cam.Render();UnityEngine.RenderTexture.active=rt;tex.ReadPixels(new UnityEngine.Rect(0,0,1280,720),0,0);tex.Apply();System.IO.File.WriteAllBytes(System.IO.Path.Combine(folder,name+".png"),UnityEngine.ImageConversion.EncodeToPNG(tex));}
 finally{canvas.renderMode=mode;canvas.worldCamera=oldCam;canvas.planeDistance=dist;cam.targetTexture=null;UnityEngine.RenderTexture.active=old;UnityEngine.Object.DestroyImmediate(tex);UnityEngine.Object.DestroyImmediate(rt);UnityEngine.Object.DestroyImmediate(go);}
};
float oldDelay=boot.AiThinkSeconds;boot.AiThinkSeconds=999;bool oldBackground=UnityEngine.Application.runInBackground;UnityEngine.Application.runInBackground=true;
var clips=new[]{"portal|王车易位|SchoolOfConjuration||-1|-1|target","portent-record|预兆|SchoolOfDivination||4|-1|self","portent-use|预知未来|SchoolOfDivination||7|3|target","illusion-hand|幻术默发|SchoolOfIllusion||2|6|target","trickery-swap|诡诈换位|TrickeryDomain||2|8|target","necromancy-swap|不死奴仆|SchoolOfNecromancy||3|9|target","ward-absorb|奥术守御|SchoolOfAbjuration||4|8|self","ward-store|奥术守御|SchoolOfAbjuration||-1|-1|self","resistance-grant|法术抗性|SchoolOfAbjuration|grant|-1|-1|target","undead-guard|不死适应|SchoolOfNecromancy||-1|-1|self","polymorph|变形术|SchoolOfTransmutation||-1|-1|target","specter|咒缚幽灵|TheHexblade||-1|-1|target","assassin-stealth|暗杀|Assassin||-1|-1|self","gloom-ambush|伏击|GloomStalker||-1|-1|self","shadow-dodge|阴影闪避|GloomStalker||-1|-1|self","ninja-clones|影分身|WayOfTheNinja||-1|-1|target","hidden-force-plant|渗透劲|WayOfTheOpenHand||-1|-1|target","hidden-force-detonate|渗透劲|WayOfTheOpenHand|detonate|4|-1|target","bladesong-enter|剑歌|Bladesinging||-1|-1|self","bladesong-exit|剑歌|Bladesinging||0|-1|self","blessing|战争祭司|WarDomain||-1|-1|target","curse|咒剑诅咒|TheHexblade||-1|-1|target","hunter-mark|猎人印记|RangerHunter||-1|-1|target","moon-bear-enter|荒野形态|CircleOfTheMoon|moon_bear|1|-1|self","moon-bear-exit|解除荒野|CircleOfTheMoon|moon_bear|0|-1|self","moon-wolf-enter|荒野形态|CircleOfTheMoon|moon_wolf|1|-1|self","moon-wolf-exit|解除荒野|CircleOfTheMoon|moon_wolf|0|-1|self","moon-eagle-enter|荒野形态|CircleOfTheMoon|moon_eagle|1|-1|self","moon-eagle-exit|解除荒野|CircleOfTheMoon|moon_eagle|0|-1|self","moon-snake-enter|荒野形态|CircleOfTheMoon|moon_snake|1|-1|self","moon-snake-exit|解除荒野|CircleOfTheMoon|moon_snake|0|-1|self","stars-archer-enter|星耀形态|CircleOfTheStars|stars_archer|1|-1|self","stars-archer-exit|解除星耀|CircleOfTheStars|stars_archer|0|-1|self","stars-chalice-enter|星耀形态|CircleOfTheStars|stars_chalice|1|-1|self","stars-chalice-exit|解除星耀|CircleOfTheStars|stars_chalice|0|-1|self","stars-dragon-enter|星耀形态|CircleOfTheStars|stars_dragon|1|-1|self","stars-dragon-exit|解除星耀|CircleOfTheStars|stars_dragon|0|-1|self","tempest-lightning|风暴之怒|TempestDomain|lightning|-1|-1|target","tempest-thunder|风暴之怒|TempestDomain|thunder|-1|-1|target","breach|破阵强袭|Breaker||-1|-1|target","reaction-cold-frost|元素反应|SchoolOfEvocation|cold_frost|-1|-1|target","reaction-cold-wet|元素反应|SchoolOfEvocation|cold_wet|-1|-1|target","reaction-cold-frozen|元素反应|SchoolOfEvocation|cold_frozen|-1|-1|target","reaction-cold-burn|元素反应|SchoolOfEvocation|cold_burn|-1|-1|target","reaction-fire-frost|元素反应|SchoolOfEvocation|fire_frost|-1|-1|target","reaction-fire-wet|元素反应|SchoolOfEvocation|fire_wet|-1|-1|target","reaction-fire-greased|元素反应|SchoolOfEvocation|fire_greased|-1|-1|target","reaction-lightning-wet|元素反应|SchoolOfEvocation|lightning_wet|-1|-1|target","reaction-thunder-resonance|元素反应|SchoolOfEvocation|thunder_resonance|-1|-1|target","reaction-lightning-resonance|元素反应|SchoolOfEvocation|lightning_resonance|-1|-1|target","reaction-thunder-shock|元素反应|SchoolOfEvocation|thunder_shock|-1|-1|target","reaction-acid-poison|元素反应|SchoolOfEvocation|acid_poison|-1|-1|target","reaction-poison-acid|元素反应|SchoolOfEvocation|poison_acid|-1|-1|target"};int index=0;double began=UnityEditor.EditorApplication.timeSinceStartup;
UnityEditor.EditorApplication.CallbackFunction tick=null;
tick=()=>{try{
 if(index>=clips.Length){UnityEditor.EditorApplication.update-=tick;board.StopAnimations();boot.AiThinkSeconds=oldDelay;invoke("ReturnToSelection",new object[0]);UnityEngine.Application.runInBackground=oldBackground;System.IO.File.WriteAllLines(System.IO.Path.Combine(folder,"native-review.txt"),checks);return;}
 if(UnityEditor.EditorApplication.timeSinceStartup-began>150)throw new System.Exception("native review timeout");
 var c=clips[index].Split('|');var definition=(CharacterDefinition)typeof(CharacterDefinition).GetProperty(c[2]).GetValue(null);
 boot.StartMatch(definition,CharacterDefinition.Blank);var g=(GameManager)field(boot,"_game");var controller=(BoardController)field(boot,"_controller");foreach(var p in g.Players)controller.BindPlayer(p,null,new SimpleChoiceProvider());
 g.RecordCombatVisuals=true;g.ClearCombatVisuals();g.PlayerA.LeftHand.SetValue(2);g.PlayerA.RightHand.SetValue(6);g.PlayerB.LeftHand.SetValue(3);g.PlayerB.RightHand.SetValue(8);if(c[1]=="王车易位"||c[1]=="荒野形态"||c[1]=="星耀形态"||c[1]=="变形术"){g.PlayerA.LeftHand.SetValue(4);g.PlayerB.LeftHand.SetValue(6);g.PlayerB.RightHand.SetValue(4);}
 invoke("RefreshView",new object[0]);
 board.ShowCombatWindup(g.PlayerA,g.PlayerA.LeftHand,"weapon_sword",AttackDamageType.Slashing);board.HideCombatWindup();
 var anim=(FingerDiceDuel.UI.CombatAnimationPlayer)field(board,"_combatAnimations");var target=c[6]=="self"?g.PlayerA:g.PlayerB;
 bool hasDestination=c[1]=="幻术默发"||c[1]=="诡诈换位"||c[1]=="不死奴仆"||c[1]=="预知未来"||c[1]=="破阵强袭";
 var data=new SkillVisualData(g.PlayerA.LeftHand,hasDestination?(c[1]=="幻术默发"?g.PlayerA.RightHand:g.PlayerB.RightHand):null,int.Parse(c[4]),int.Parse(c[5]),c[3],c[1]=="幻术默发"?g.PlayerA:g.PlayerB);
 g.RecordSkillVisual(g.PlayerA,c[1],target,data);var events=g.DrainCombatVisuals();check(events.Count==1,"cue "+c[0]);
 System.IO.Directory.CreateDirectory(System.IO.Path.Combine(folder,c[0]));
 anim.PreviewFinalSkill(events[0],.28f);shot(c[0]+"/windup");
 anim.PreviewFinalSkill(events[0],.62f);shot(c[0]+"/peak");
 foreach(var sprite in ((UnityEngine.RectTransform)field(anim,"_root")).GetComponentsInChildren<UnityEngine.UI.Image>())if(sprite.enabled&&sprite.gameObject.activeInHierarchy)check(sprite.sprite!=null,"sprite "+c[0]+" "+sprite.name);
 anim.StopPlayback();check(!board.CombatAnimationBusy,"cleanup "+c[0]);index++;
 }catch(System.Exception ex){UnityEditor.EditorApplication.update-=tick;board.StopAnimations();boot.AiThinkSeconds=oldDelay;invoke("ReturnToSelection",new object[0]);UnityEngine.Application.runInBackground=oldBackground;System.IO.File.WriteAllText(System.IO.Path.Combine(folder,"native-error.txt"),ex.ToString());}};
UnityEditor.EditorApplication.update+=tick;return "Started native production-pose review: "+clips.Length+" clips, two PNG frames each.";
