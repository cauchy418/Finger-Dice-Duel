tick=()=>{try{
 if(UnityEditor.EditorApplication.timeSinceStartup-began>180)throw new System.Exception("queue review timeout");
 if(stage==0){
  invoke("CleanupMatch",new object[0]);
  if(group==1||group==2){var lesson=TatteredBannersLesson.Create(group==1?21:29,0);invoke("BindBannersMatch",new object[]{lesson});boot.GetType().GetField("_adventure",flags).SetValue(boot,null);lesson.Board.TutorialInput=null;invoke("StartPreparedMatch",new object[]{false});}else boot.StartMatch(CharacterDefinition.Blank,CharacterDefinition.Blank);
  g=(GameManager)field(boot,"_game");var controller=(BoardController)field(boot,"_controller");foreach(var p in g.Players)controller.BindPlayer(p,null,new SimpleChoiceProvider());g.RecordCombatVisuals=true;g.ClearCombatVisuals();invoke("RefreshView",new object[0]);
  board.ShowCombatWindup(g.Players[0],g.Players[0].LeftHand,"weapon_sword",AttackDamageType.Slashing);board.HideCombatWindup();anim=(FingerDiceDuel.UI.CombatAnimationPlayer)field(board,"_combatAnimations");baseline=anim.PlayedEvents;
  var actor=g.Players[0];var enemy=g.Players[1];
  for(int i=0;i<specs.Length;i++){
   var c=specs[i].Split('|');if((group==1||group==2)&&i%9!=0)continue;
   var target=c[6]=="self"?actor:enemy;actor.ClearStatuses();enemy.ClearStatuses();var status=(StatusEffect)System.Enum.Parse(typeof(StatusEffect),c[5]);if(status!=StatusEffect.None)target.ApplyStatus(status,2,actor);
   var data=new SkillVisualData(actor.LeftHand,enemy.RightHand,int.Parse(c[2]),int.Parse(c[3]),c[1],enemy,(AttackDamageType)System.Enum.Parse(typeof(AttackDamageType),c[4]),status);g.RecordSkillVisual(actor,c[0],target,data);
  }
  var events=g.DrainCombatVisuals();count=events.Count;done=false;current=null;board.PlayCombatEvents(events,g.CaptureVisualFrame(),()=>done=true);check(board.CombatAnimationBusy,"queue starts "+group);check(!canvas.GetComponent<UnityEngine.CanvasGroup>().interactable,"input locks "+group);stage=1;captured=false;captureAt=UnityEngine.Time.unscaledTime+.20f;
  if(group==3)foreach(var button in ((UnityEngine.GameObject)field(anim,"_controls")).GetComponentsInChildren<UnityEngine.UI.Button>())if(button.name=="Skip")button.onClick.Invoke();
  if(group==4){board.StopAnimations();check(!board.CombatAnimationBusy,"mid-play stop clears busy");check(canvas.GetComponent<UnityEngine.CanvasGroup>().interactable,"mid-play stop unlocks input");done=true;}
 }else{
  if(UnityEditor.EditorApplication.timeSinceStartup-lastProgress>3){lastProgress=UnityEditor.EditorApplication.timeSinceStartup;System.IO.File.AppendAllText(System.IO.Path.Combine(folder,"queue-progress.txt"),"group="+group+" elapsed="+(lastProgress-began)+" playtime="+UnityEngine.Time.unscaledTime+" dt="+UnityEngine.Time.unscaledDeltaTime+" busy="+board.CombatAnimationBusy+" active="+anim.isActiveAndEnabled+" current="+anim.Current?.RedirectKind+" played="+(anim.PlayedEvents-baseline)+" routine="+(field(anim,"_routine")!=null)+"\n");}
  UnityEditor.EditorApplication.QueuePlayerLoopUpdate();
  if(anim.Current!=null){var origin=(UnityEngine.Vector2)field(anim,"_skillOrigin");if(!object.ReferenceEquals(current,anim.Current)){current=anim.Current;fixedOrigin=origin;}else if(origin!=fixedOrigin)throw new System.Exception("moving path anchor "+group);}
  if((group==1||group==2)&&!captured&&UnityEngine.Time.unscaledTime>=captureAt){shot("p23-flight-mode-"+group);captured=true;}
  if(!done)return;
  check(!board.CombatAnimationBusy,"queue completes "+group);if(group!=4)check(anim.PlayedEvents-baseline==count,"every clip played "+group+" count="+count);check(canvas.GetComponent<UnityEngine.CanvasGroup>().interactable,"input restores "+group);
  check(((System.Collections.ICollection)field(anim,"_finalNumbers")).Count==0,"digit helpers cleaned "+group);check(((System.Collections.IDictionary)field(board,"_evadeOrigins")).Count==0,"poses restored "+group);
  check(g.Players.Count==(group==1?4:group==2?8:2),"expected layout "+group);shot("p23-queue-mode-"+group);group++;stage=0;
  if(group==5){UnityEditor.EditorApplication.update-=tick;invoke("ReturnToSelection",new object[0]);boot.AiThinkSeconds=oldDelay;UnityEngine.Application.runInBackground=oldBackground;System.IO.File.WriteAllLines(System.IO.Path.Combine(folder,"p23-queue-validation.txt"),checks);}
 }
 }catch(System.Exception ex){UnityEditor.EditorApplication.update-=tick;board.StopAnimations();boot.AiThinkSeconds=oldDelay;UnityEngine.Application.runInBackground=oldBackground;System.IO.File.WriteAllText(System.IO.Path.Combine(folder,"p23-queue-validation.txt"),string.Join("\n",checks)+"\nFAIL "+ex);}};
